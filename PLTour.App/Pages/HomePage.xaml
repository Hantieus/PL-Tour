<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PLTour.App.Converters"
             x:Class="PLTour.App.Pages.HomePage"
             Title="{loc:Localization Home}"
             BackgroundColor="#F5F7FA">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">
                <Border x:Name="OfflineBanner"
                        IsVisible="False"
                        BackgroundColor="#FEF3C7"
                        Stroke="#F59E0B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="18" />
                        <Label Text="Ứng dụng đang dùng dữ liệu đã lưu tạm. Một số nội dung có thể chưa cập nhật." TextColor="#92400E" FontSize="13" LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 22"
                            HeightRequest="58"
                            WidthRequest="58"
                            Padding="10"
                            BackgroundColor="#E6FFFB"
                            StrokeThickness="1"
                            Stroke="#99F6E4">
                        <Image Source="logo.png" Aspect="AspectFit"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Localization HomeGreeting}"
                               FontSize="13"
                               TextColor="#64748B"/>
                        <Label Text="{loc:Localization HomeSubtitle}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F766E"/>
                    </VerticalStackLayout>
                </Grid>

                <Border StrokeShape="RoundRectangle 24"
                        Padding="18"
                        BackgroundColor="#0F766E">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.18" Offset="0,6" Radius="14" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="92,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="#FFFFFF"
                                StrokeShape="RoundRectangle 22"
                                Padding="12"
                                HeightRequest="92"
                                WidthRequest="92">
                            <Image Source="logo.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{loc:Localization HomeExploreTitle}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"/>
                            <Label Text="{loc:Localization HomeExploreDesc}"
                                   TextColor="#E2E8F0"
                                   FontSize="12"/>
                            <Button Text="{loc:Localization HomeOpenMap}"
                                    Margin="0,8,0,0"
                                    WidthRequest="124"
                                    HorizontalOptions="Start"
                                    BackgroundColor="#F97316"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="18"
                                    Clicked="GoToMap_Clicked"
                                    HeightRequest="38"
                                    Padding="0"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="📍"
                               FontSize="44"
                               VerticalOptions="Center"
                               TextColor="White"/>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="2,8,0,0">
                    <Label Text="{loc:Localization HomeSuggestedTours}"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="#111827"/>
                </Grid>

                <Border StrokeShape="RoundRectangle 14"
                        Padding="10,8"
                        BackgroundColor="#EFF6FF"
                        Stroke="#93C5FD"
                        StrokeThickness="1">
                    <Label Text="{Binding SyncStatusText}"
                           TextColor="#1E3A8A"
                           FontSize="12"
                           FontAttributes="Bold"/>
                </Border>

                <CollectionView x:Name="TourListView" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 18" Padding="0" BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.12" Offset="0,4" Radius="10"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="160,Auto">
                                    <Image Grid.Row="0" Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="8">
                                        <Label Text="{Binding LocalizedName}"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#111827"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding DurationDisplay, StringFormat='⏳ {0}'}" TextColor="#64748B" FontSize="13"/>
                                            <Label Text="•" TextColor="#94A3B8"/>
                                            <Label Text="{Binding DistanceDisplay}" TextColor="#F97316" FontAttributes="Bold" FontSize="13"/>
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                                            <Button Grid.Column="0"
                                                    Text="{Binding PlayButtonText}"
                                                    Clicked="SpeakTour_Clicked"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{Binding PlayButtonColor}"
                                                    TextColor="Black"
                                                    HeightRequest="40"
                                                    CornerRadius="12"/>
                                            <Button Grid.Column="1"
                                                    Text="{loc:Localization Details}"
                                                    Clicked="ViewTourDetail_Clicked"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#0F766E"
                                                    TextColor="White"
                                                    HeightRequest="40"
                                                    CornerRadius="12"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="#0F766E"/>
    </Grid>
</ContentPage>
