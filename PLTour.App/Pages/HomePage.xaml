<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PLTour.App.Converters"
             x:Class="PLTour.App.Pages.HomePage"
             Title="{loc:Localization Home}"
             BackgroundColor="#F5F5F5">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" Padding="0">
                        <Image Source="user_avatar.png" Aspect="AspectFill"/>
                    </Border>
                    <VerticalStackLayout>
                        <Label Text="{loc:Localization HomeGreeting}" FontSize="14" TextColor="Gray"/>
                        <Label Text="{loc:Localization HomeSubtitle}" FontSize="18" FontAttributes="Bold" TextColor="#2A9D8F"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>


                <Border StrokeShape="RoundRectangle 20" Padding="20" BackgroundColor="#2A9D8F">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{loc:Localization HomeExploreTitle}" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="{loc:Localization HomeExploreDesc}" TextColor="#E0E0E0" FontSize="12"/>
                            <Button Text="{loc:Localization HomeOpenMap}" Margin="0,10,0,0" WidthRequest="120" HorizontalOptions="Start"
                                    BackgroundColor="#E76F51" Clicked="GoToMap_Clicked" HeightRequest="35" Padding="0"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="📍" FontSize="50" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Label Text="{loc:Localization HomeSuggestedTours}" FontAttributes="Bold" FontSize="20" Margin="0,10,0,0"/>

                <CollectionView x:Name="TourListView" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 15" Padding="0" BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Brush="Gray" Opacity="0.2" Offset="0,4"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="150, Auto">
                                    <Image Grid.Row="0" Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                    <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="5">
                                        <Label Text="{Binding LocalizedName}" FontAttributes="Bold" FontSize="18"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding DurationDisplay, StringFormat='⏳ {0}'}" TextColor="Gray" FontSize="13"/>
                                            <Label Text="•" TextColor="Gray"/>
                                            <Label Text="{Binding DistanceDisplay}" TextColor="#E76F51" FontAttributes="Bold" FontSize="13"/>
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                                            <Button Grid.Column="0" Text="{Binding PlayButtonText}" Clicked="SpeakTour_Clicked" CommandParameter="{Binding .}" 
                                                    BackgroundColor="{Binding PlayButtonColor}" TextColor="Black" HeightRequest="40"/>
                                            <Button Grid.Column="1" Text="{loc:Localization Details}" Clicked="ViewTourDetail_Clicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#2A9D8F" HeightRequest="40"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" VerticalOptions="Center" HorizontalOptions="Center" Color="#2A9D8F"/>
    </Grid>
</ContentPage>