<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PLTour.App.Converters"
             x:Class="PLTour.App.Pages.PoiDetailPopupView"
             BackgroundColor="#99000000"
             IsVisible="False">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="360"
            MaximumHeightRequest="680"
            Padding="0"
            Margin="20">

        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="18" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*,Auto">
            <Grid>
                <Image Source="{Binding ImageUrl}"
                       HeightRequest="220"
                       Aspect="AspectFill"
                       BackgroundColor="#EEF2F7" />
                <Border HorizontalOptions="Fill"
                        VerticalOptions="End"
                        Padding="16,18,16,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#A6000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="22"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Button Text="{loc:Localization Close}"
                        BackgroundColor="#00000066"
                        TextColor="White"
                        CornerRadius="18"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="14"
                        Clicked="ClosePopup_Clicked" />
            </Grid>

            <ScrollView Grid.Row="1" Padding="20,18">
                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 16"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Localization PoiInfoTitle}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#2A9D8F" />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <Label Text="{loc:Localization Address}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Column="1"
                                       Text="{Binding Address}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap" />

                                <Label Grid.Row="1"
                                       Text="{loc:Localization Category}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Category}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       LineBreakMode="WordWrap" />

                                <Label Grid.Row="2"
                                       Text="{loc:Localization Distance}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding DistanceText}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 16"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Localization PoiContentTitle}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#2A9D8F" />
                            <Label Text="{Binding FullContent}"
                                   FontSize="14"
                                   TextColor="#111827"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Menu nhà hàng"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#0F172A" />
                                    <Label Text="Danh sách món đang phục vụ"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        BackgroundColor="#E6F7F4"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="10,6">
                                    <Label Text="{Binding StoreProducts.Count, StringFormat='{}{0} món'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#0F766E" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StoreProducts}"
                                                 Spacing="12">
                                <BindableLayout.EmptyView>
                                    <Border Padding="14"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 14">
                                        <Label Text="Chưa có menu cho nhà hàng này"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="Center" />
                                    </Border>
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                BackgroundColor="White"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 16">
                                            <Grid ColumnDefinitions="84,*,Auto" ColumnSpacing="12">
                                                <Border WidthRequest="84"
                                                        HeightRequest="84"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14"
                                                        BackgroundColor="#F1F5F9">
                                                    <Image Source="{Binding ImageUrl}"
                                                           Aspect="AspectFill" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontAttributes="Bold"
                                                           FontSize="15"
                                                           TextColor="#0F172A"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding CategoryName}"
                                                           FontSize="12"
                                                           TextColor="#64748B"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Description}"
                                                           FontSize="12"
                                                           TextColor="#64748B"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2"
                                                                     Spacing="8"
                                                                     HorizontalOptions="End"
                                                                     VerticalOptions="Center">
                                                    <Border BackgroundColor="#F0FDF4"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 999"
                                                            Padding="10,6">
                                                        <Label Text="{Binding Price, StringFormat='{}{0:N0} đ'}"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               TextColor="#166534"
                                                               HorizontalTextAlignment="End" />
                                                    </Border>
                                                    <Border BackgroundColor="#F8FAFC"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 999"
                                                            Padding="10,5">
                                                        <Label Text="{Binding IsAvailable, StringFormat='Còn hàng: {0}'}"
                                                               FontSize="11"
                                                               TextColor="#475569"
                                                               HorizontalTextAlignment="End" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,0,20,20">
                <Button Text="{loc:Localization ViewMap}"
                        BackgroundColor="#EAF2F2"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="14"
                        Clicked="BtnViewMap_Clicked" />

                <Button Grid.Column="1"
                        Text="{Binding PlayButtonText}"
                        BackgroundColor="{Binding PlayButtonColor}"
                        Clicked="BtnSpeak_Clicked"
                        HeightRequest="50"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14" />
            </Grid>
        </Grid>
    </Border>
</ContentView>