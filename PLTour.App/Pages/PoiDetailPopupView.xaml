<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PLTour.App.Converters"
             x:Class="PLTour.App.Pages.PoiDetailPopupView"
             BackgroundColor="#99000000"
             IsVisible="False">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="360"
            MaximumHeightRequest="680"
            Padding="0"
            Margin="20">

        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="18" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*,Auto">
            <Grid>
                <Image Source="{Binding ImageUrl}"
                       HeightRequest="220"
                       Aspect="AspectFill"
                       BackgroundColor="#EEF2F7" />
                <Border HorizontalOptions="Fill"
                        VerticalOptions="End"
                        Padding="16,18,16,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#A6000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="22"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Button Text="{loc:Localization Close}"
                        BackgroundColor="#00000066"
                        TextColor="White"
                        CornerRadius="18"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="14"
                        Clicked="ClosePopup_Clicked" />
            </Grid>

            <ScrollView Grid.Row="1" Padding="20,18">
                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 16"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Localization PoiInfoTitle}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#2A9D8F" />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <Label Text="{loc:Localization Address}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Column="1"
                                       Text="{Binding Address}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap" />

                                <Label Grid.Row="1"
                                       Text="{loc:Localization Category}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Category}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       LineBreakMode="WordWrap" />

                                <Label Grid.Row="2"
                                       Text="{loc:Localization Distance}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding DistanceText}"
                                       FontSize="14"
                                       TextColor="#111827"
                                       FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 16"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Localization PoiContentTitle}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#2A9D8F" />
                            <Label Text="{Binding FullContent}"
                                   FontSize="14"
                                   TextColor="#111827"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,0,20,20">
                <Button Text="{loc:Localization ViewMap}"
                        BackgroundColor="#EAF2F2"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="14"
                        Clicked="BtnViewMap_Clicked" />

                <Button Grid.Column="1"
                        Text="{Binding PlayButtonText}"
                        BackgroundColor="{Binding PlayButtonColor}"
                        Clicked="BtnSpeak_Clicked"
                        HeightRequest="50"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14" />
            </Grid>
        </Grid>
    </Border>
</ContentView>