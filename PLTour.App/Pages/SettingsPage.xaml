<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PLTour.App.Converters"
             x:Class="PLTour.App.Pages.SettingsPage"
             Title="Cài đặt">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border StrokeThickness="1" Stroke="#93C5FD" Padding="16" StrokeShape="RoundRectangle 16" BackgroundColor="#EFF6FF">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Offline-first" FontAttributes="Bold" FontSize="18" TextColor="#1E3A8A" />
                    <Label Text="Ứng dụng vẫn xem được dữ liệu tour/POI khi mất mạng. Dữ liệu sẽ được lưu tạm và đồng bộ lại khi có kết nối." FontSize="13" TextColor="#1E3A8A" LineBreakMode="WordWrap" />
                    <Label Text="Trạng thái mạng: {Binding OfflineStatusText}" FontSize="12" FontAttributes="Bold" TextColor="#1D4ED8" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Giao diện" FontAttributes="Bold"/>
            <HorizontalStackLayout Spacing="10">
                <Label Text="Chế độ tối (Dark Mode)" VerticalOptions="Center"/>
                <Switch x:Name="ThemeSwitch" Toggled="ThemeSwitch_Toggled"/>
            </HorizontalStackLayout>

            <Label Text="Ngôn ngữ &amp; Thuyết minh" FontAttributes="Bold"/>
            <Picker x:Name="LangPicker" Title="Chọn ngôn ngữ thuyết minh">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Tiếng Việt</x:String>
                        <x:String>English</x:String>
                        <x:String>中文</x:String>
                        <x:String>한국어</x:String>
                        <x:String>日本語</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Border StrokeThickness="1" Stroke="#D1D5DB" Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Hàng đợi monitoring" FontAttributes="Bold" />
                    <Label Text="{Binding QueueStatusText}" FontSize="13" />
                    <ProgressBar Progress="{Binding QueueProgress}" HeightRequest="8" />
                    <Label Text="{Binding QueueHintText}" FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="#D1D5DB" Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Quản lý dữ liệu offline" FontAttributes="Bold" />
                    <Label Text="{Binding OfflineStatusText}" FontSize="13" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Xóa cache" Clicked="ClearCache_Clicked" BackgroundColor="#F87171" TextColor="White" CornerRadius="10" />
                        <Button Text="Đồng bộ lại ngay" Clicked="SyncNow_Clicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="10" />
                    </HorizontalStackLayout>
                    <Label Text="Xóa cache sẽ xóa dữ liệu tour/location đã lưu tạm. Đồng bộ lại ngay sẽ gửi các sự kiện đang chờ lên server." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="#D1D5DB" Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Auto-play gần POI" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Bật tự động phát khi vào vùng POI" VerticalOptions="Center" />
                        <Switch x:Name="AutoPlaySwitch" Toggled="AutoPlaySwitch_Toggled" HorizontalOptions="EndAndExpand" />
                    </HorizontalStackLayout>
                    <Label Text="Khi bật, app sẽ tự phát thuyết minh một lần khi bạn đi vào bán kính của POI." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>