<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PLTour.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PLTour.App.Pages"
    xmlns:loc="clr-namespace:PLTour.App.Converters"
    Title="PLTour">

    <TabBar>
        <ShellContent
            Title="{loc:Localization Home}"
            Route="home"
            ContentTemplate="{DataTemplate pages:HomePage}" />

        <ShellContent
            Title="{loc:Localization Map}"
            Route="map"
            ContentTemplate="{DataTemplate pages:MapPage}" />

        <ShellContent
            Title="{loc:Localization QR Scan}"
            Route="qr"
            ContentTemplate="{DataTemplate pages:QrScannerPage}" />

        <ShellContent
            Title="{loc:Localization Settings}"
            Route="settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>