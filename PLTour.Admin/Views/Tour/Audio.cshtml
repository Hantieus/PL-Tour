@model PLTour.Shared.Models.Entities.Tour

@{
    ViewData["Title"] = $"Quản lý audio - {Model.Name}";
    var languages = ViewBag.Languages as IEnumerable<PLTour.Shared.Models.Entities.Language> ?? Enumerable.Empty<PLTour.Shared.Models.Entities.Language>();
    var hasAnyNarration = Model.TourNarrations != null && Model.TourNarrations.Any(x => x.IsActive);
    var submitButtonText = hasAnyNarration ? "Cập nhật audio" : "Lưu và tạo audio";
    var submitButtonIcon = hasAnyNarration ? "fas fa-pen-to-square" : "fas fa-wand-magic-sparkles";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Tạo và quản lý thuyết minh cho tour theo từng ngôn ngữ.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách tour
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-route me-2"></i>Thông tin tour
                </div>
                <div class="card-body">
                    <div class="mb-2"><strong>Tên:</strong> @Model.Name</div>
                    <div class="mb-2"><strong>Thời lượng:</strong> @Model.Duration phút</div>
                    <div class="mb-2"><strong>IntroText:</strong></div>
                    <div class="border rounded-3 p-3 bg-light" style="min-height:140px; white-space:pre-wrap;">
                        @(string.IsNullOrWhiteSpace(Model.IntroText) ? "Tour chưa có nội dung giới thiệu." : Model.IntroText)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-plus-circle me-2"></i>Thêm / tạo lại narration tour
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(Model.IntroText))
                    {
                        <div class="alert alert-warning mb-3">
                            Tour chưa có IntroText nên chưa thể tạo audio.
                        </div>
                    }
                    else if (hasAnyNarration)
                    {
                        <div class="alert alert-info mb-3">
                            Narration đã tồn tại. Khi bấm <strong>Cập nhật audio</strong>, hệ thống sẽ tạo lại audio theo IntroText mới.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-3">
                            Chưa có narration nào. Khi bấm <strong>Lưu và tạo audio</strong>, hệ thống sẽ tạo narration và audio lần đầu.
                        </div>
                    }

                    <form asp-action="UpsertTourNarration" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tourId" value="@Model.TourId" />

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <label class="form-label fw-semibold mb-0">Chọn ngôn ngữ</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllLanguagesBtn">
                                    <i class="fas fa-check-double me-1"></i>Chọn tất cả
                                </button>
                            </div>
                            <div class="row g-2" id="languageCheckboxList">
                                @foreach (var lang in languages)
                                {
                                    <div class="col-md-4 col-lg-3">
                                        <div class="form-check border rounded p-2 h-100">
                                            <input class="form-check-input language-checkbox" type="checkbox" name="languageIds" value="@lang.LanguageId" id="lang_@lang.LanguageId" />
                                            <label class="form-check-label ms-1" for="lang_@lang.LanguageId">
                                                @lang.Name (@lang.Code)
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">Có thể chọn nhiều ngôn ngữ. Khi lưu, hệ thống sẽ tự dịch nội dung gốc và tạo narration + audio cho từng ngôn ngữ đã chọn.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tiêu đề gốc (Tiếng Việt)</label>
                            <input type="text" name="title" class="form-control" value="@Model.Name" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Nội dung gốc (Tiếng Việt)</label>
                            <textarea name="content" class="form-control" rows="5" required>@Model.IntroText</textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Thời lượng (giây)</label>
                            <input type="number" name="duration" class="form-control" min="0" value="0" />
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isDefault" value="true" checked />
                                <label class="form-check-label">Đặt mặc định cho bản tiếng Việt</label>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="@submitButtonIcon me-1"></i>@submitButtonText
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span><i class="fas fa-headphones me-2"></i>Danh sách narration hiện có</span>
            <span class="badge bg-dark">@((Model.TourNarrations?.Count ?? 0)) bản ghi</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Ngôn ngữ</th>
                            <th>Tiêu đề</th>
                            <th>Audio</th>
                            <th>Trạng thái</th>
                            <th>Mặc định</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TourNarrations != null && Model.TourNarrations.Any())
                        {
                            foreach (var item in Model.TourNarrations.OrderByDescending(x => x.CreatedDate))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(item.Language?.Name ?? $"Language #{item.LanguageId}")</div>
                                        <small class="text-muted">@item.Language?.Code</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        <small class="text-muted">v@item.Version</small>
                                    </td>
                                    <td style="max-width:360px; word-break:break-all;">
                                        <div class="d-flex flex-column gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.AudioUrl))
                                            {
                                                <a href="@item.AudioUrl" target="_blank">@item.AudioUrl</a>
                                                <audio controls preload="none" style="width:100%;">
                                                    <source src="@item.AudioUrl" type="audio/mpeg" />
                                                </audio>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa có audio</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsDefault)
                                        {
                                            <span class="badge bg-primary">Default</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="openEditModal(this)"
                                                    data-narration-id="@item.TourNarrationId"
                                                    data-title="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Title))"
                                                    data-content="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Content))"
                                                    data-duration="@item.Duration"
                                                    data-is-default="@item.IsDefault.ToString().ToLower()"
                                                    data-is-active="@item.IsActive.ToString().ToLower()"
                                                    data-audio-url="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.AudioUrl ?? string.Empty))"
                                                    data-language-name="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Language?.Name ?? string.Empty))">
                                                <i class="fas fa-pen-to-square me-1"></i>Sửa
                                            </button>
                                            <form asp-action="DeleteTourNarration" method="post" onsubmit="return confirm('Bạn có chắc muốn tắt narration này không?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.TourNarrationId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-ban me-1"></i>Tắt
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Chưa có narration nào cho tour này.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal sửa narration -->
<div class="modal fade" id="editNarrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="max-height: 90vh;">
            <form asp-action="UpdateTourNarration" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Sửa narration tour</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: calc(90vh - 140px); overflow-y: auto;">
                    <input type="hidden" name="id" id="editNarrationId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngôn ngữ</label>
                        <input type="text" class="form-control" id="editLanguageName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề</label>
                        <input type="text" class="form-control" name="title" id="editTitle" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung</label>
                        <textarea class="form-control" name="content" id="editContent" rows="5" required></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Thời lượng (giây)</label>
                            <input type="number" class="form-control" name="duration" id="editDuration" min="0" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isDefault" id="editIsDefault" value="true" />
                                <label class="form-check-label" for="editIsDefault">Mặc định</label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isActive" id="editIsActive" value="true" />
                                <label class="form-check-label" for="editIsActive">Kích hoạt</label>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Audio hiện tại</label>
                        <div id="editCurrentAudioWrap" class="mb-2"></div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="removeAudio" id="editRemoveAudio" value="true" />
                            <label class="form-check-label text-danger" for="editRemoveAudio">Xóa audio hiện tại</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tải lên audio mới</label>
                        <input type="file" name="audioFile" id="editAudioFile" class="form-control" accept="audio/*" />
                        <div class="form-text" id="editAudioFileName">Chưa chọn file nào.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editNarrationModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                fillEditModal(button);
            });
        }

        function openEditModal(button) {
            const modalEl = document.getElementById('editNarrationModal');
            fillEditModal(button);
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }

        function fillEditModal(button) {
            const narrationId = button.getAttribute('data-narration-id');
            const title = decodeUnicodeEscapes(button.getAttribute('data-title') || '');
            const content = decodeUnicodeEscapes(button.getAttribute('data-content') || '');
            const duration = button.getAttribute('data-duration') || '0';
            const isDefault = button.getAttribute('data-is-default') === 'true';
            const isActive = button.getAttribute('data-is-active') === 'true';
            const audioUrl = button.getAttribute('data-audio-url') || '';
            const languageName = decodeUnicodeEscapes(button.getAttribute('data-language-name') || '');

            document.getElementById('editNarrationId').value = narrationId;
            document.getElementById('editTitle').value = title;
            document.getElementById('editContent').value = content;
            document.getElementById('editDuration').value = duration;
            document.getElementById('editIsDefault').checked = isDefault;
            document.getElementById('editIsActive').checked = isActive;
            document.getElementById('editLanguageName').value = languageName;
            document.getElementById('editRemoveAudio').checked = false;

            const fileInput = document.getElementById('editAudioFile');
            const fileName = document.getElementById('editAudioFileName');
            if (fileInput) fileInput.value = '';
            if (fileName) fileName.textContent = 'Chưa chọn file nào.';

            const audioWrap = document.getElementById('editCurrentAudioWrap');
            audioWrap.innerHTML = audioUrl
                ? `<audio controls class="w-100"><source src="${audioUrl}" type="audio/mpeg"></audio>`
                : '<div class="alert alert-light border mb-0">Chưa có audio cho narration này.</div>';
        }

        const editAudioFile = document.getElementById('editAudioFile');
        if (editAudioFile) {
            editAudioFile.addEventListener('change', function () {
                const fileName = document.getElementById('editAudioFileName');
                if (fileName) {
                    fileName.textContent = this.files && this.files.length > 0
                        ? `Đã chọn: ${this.files[0].name}`
                        : 'Chưa chọn file nào.';
                }
            });
        }

        const selectAllLanguagesBtn = document.getElementById('selectAllLanguagesBtn');
        if (selectAllLanguagesBtn) {
            selectAllLanguagesBtn.addEventListener('click', function () {
                document.querySelectorAll('.language-checkbox').forEach(cb => cb.checked = true);
            });
        }

        function decodeUnicodeEscapes(value) {
            if (!value) return '';
            try {
                return value.replace(/\\u([0-9a-fA-F]{4})/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)));
            } catch {
                return value;
            }
        }
    </script>
}
