@model PLTour.Shared.Models.Entities.Narration
@{
    var location = ViewBag.Location as PLTour.Shared.Models.Entities.Location;
    ViewData["Title"] = "Sửa bài thuyết minh";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Chỉnh sửa narration cho địa điểm.</p>
        </div>
        <a asp-action="ByLocation" asp-route-locationId="@location?.LocationId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-edit me-2"></i>Cập nhật narration
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NarrationId" />
                <input type="hidden" asp-for="LocationId" />
                <input type="hidden" asp-for="Version" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="AudioUrl" />

                <div class="col-12">
                    <label class="form-label fw-semibold">Địa điểm</label>
                    <input type="text" class="form-control" value="@location?.Name" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngôn ngữ</label>
                    <input type="text" class="form-control" value="@(ViewBag.LanguageName ?? string.Empty)" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label fw-semibold">Duration (giây)</label>
                    <input asp-for="Duration" class="form-control" type="number" min="0" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-semibold">Title</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Content" class="form-label fw-semibold">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="7"></textarea>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-2">
                        <input asp-for="IsDefault" class="form-check-input" />
                        <label asp-for="IsDefault" class="form-check-label">Đặt làm mặc định</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a asp-action="ByLocation" asp-route-locationId="@location?.LocationId" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-warning">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>