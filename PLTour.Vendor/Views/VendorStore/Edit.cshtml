@model PLTour.Shared.Models.Entities.VendorStore
@{
    ViewData["Title"] = "Sửa cửa hàng";
    Layout = "_VendorLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Sửa cửa hàng</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="StoreId" />
                        <div class="mb-3">
                            <label asp-for="StoreName" class="form-label">Tên cửa hàng</label>
                            <input asp-for="StoreName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ảnh đại diện cửa hàng</label>
                            <input type="file" name="logoFile" class="form-control" accept="image/*" />
                            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                            {
                                <div class="mt-2">
                                    <img src="@Model.LogoUrl" alt="Logo" class="img-thumbnail" style="max-height: 120px;" />
                                </div>
                            }
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">Địa chỉ</label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Latitude" class="form-label">Vĩ độ</label>
                                <input asp-for="Latitude" class="form-control" type="number" step="0.000001" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Longitude" class="form-label">Kinh độ</label>
                                <input asp-for="Longitude" class="form-control" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                            <a href="/vendor-store" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
