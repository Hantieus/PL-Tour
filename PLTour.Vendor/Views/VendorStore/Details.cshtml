@model PLTour.Shared.Models.Entities.VendorStore
@{
    ViewData["Title"] = "Chi tiết cửa hàng";
    Layout = "_VendorLayout";
    var narrations = ViewBag.Narrations as IEnumerable<PLTour.Shared.Models.Entities.Narration> ?? Enumerable.Empty<PLTour.Shared.Models.Entities.Narration>();
}

<div class="container py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="mb-1">@Model.StoreName</h2>
                    <div class="text-muted">@(Model.Location?.Name ?? "Chưa gắn Location")</div>
                </div>
                <a href="/vendor-store/edit/@Model.StoreId" class="btn btn-primary">Sửa</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" alt="@Model.StoreName" class="img-fluid rounded mb-3" style="max-height: 260px; object-fit: cover;" />
            }

            <p>@Model.Description</p>
            <div class="row g-3">
                <div class="col-md-6"><strong>Địa chỉ:</strong> @(Model.Address ?? "Chưa có")</div>
                <div class="col-md-3"><strong>Vĩ độ:</strong> @(Model.Latitude?.ToString() ?? "-")</div>
                <div class="col-md-3"><strong>Kinh độ:</strong> @(Model.Longitude?.ToString() ?? "-")</div>
            </div>
            <div class="mt-3">
                @if (Model.LocationId.HasValue)
                {
                    <a asp-controller="Narration" asp-action="Create" asp-route-locationId="@Model.LocationId.Value" class="btn btn-outline-primary">+ Thêm thuyết minh</a>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Thuyết minh của cửa hàng</h5>
            @if (Model.LocationId.HasValue)
            {
                <a href="/narration/create?locationId=@Model.LocationId.Value" class="btn btn-sm btn-primary">+ Thêm thuyết minh</a>
            }
        </div>
        <div class="card-body">
            @if (Model.LocationId.HasValue)
            {
                @if (narrations.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var narration in narrations)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@narration.Title</div>
                                        <small class="text-muted">@narration.Language?.Name</small>
                                    </div>
                                    <span class="badge bg-@(narration.IsDefault ? "primary" : "secondary")">@(narration.IsDefault ? "Mặc định" : "Khác")</span>
                                </div>
                                <div class="mt-2 text-muted">@narration.Content</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Chưa có bài thuyết minh cho cửa hàng này.</div>
                }
            }
            else
            {
                <div class="text-muted">Cửa hàng chưa được gắn Location nên chưa thể thêm thuyết minh.</div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Sản phẩm của cửa hàng</h5>
        </div>
        <div class="card-body">
            @if (Model.Products?.Any() == true)
            {
                <div class="list-group list-group-flush">
                    @foreach (var product in Model.Products)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@product.Name</div>
                                <small class="text-muted">@product.Price.ToString("N0") đ</small>
                            </div>
                            <span class="badge bg-@(product.IsAvailable ? "success" : "secondary")">@(product.IsAvailable ? "Còn hàng" : "Hết hàng")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted">Chưa có sản phẩm nào.</div>
            }
        </div>
    </div>
</div>
