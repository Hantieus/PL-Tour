@model PLTour.Shared.Models.Entities.VendorStore
@{
    ViewData["Title"] = "Tạo cửa hàng";
    Layout = "_VendorLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Tạo cửa hàng mới</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="StoreName" class="form-label">Tên cửa hàng</label>
                            <input asp-for="StoreName" class="form-control" />
                            <span asp-validation-for="StoreName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ảnh đại diện cửa hàng</label>
                            <input type="file" name="logoFile" class="form-control" accept="image/*" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">Địa chỉ</label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Latitude" class="form-label">Vĩ độ</label>
                                <input asp-for="Latitude" class="form-control" type="number" step="0.000001" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Longitude" class="form-label">Kinh độ</label>
                                <input asp-for="Longitude" class="form-control" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">Lưu cửa hàng</button>
                            <a href="/vendor-store" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
