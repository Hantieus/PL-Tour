@model PLTour.Shared.Models.Entities.Vendor
@{
    ViewData["Title"] = "Nâng cấp gói";
    Layout = "_VendorLayout";
    var premiumPrice = (decimal)(ViewBag.PremiumPrice ?? 199000m);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fas fa-crown me-2"></i>Nâng cấp gói Premium</h4>
                </div>
                <div class="card-body">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-6">
                            <div class="p-4 border rounded-3 h-100">
                                <h5 class="text-muted">Gói hiện tại</h5>
                                <h3>@(string.IsNullOrWhiteSpace(Model.Plan) ? "Free" : Model.Plan)</h3>
                                <p class="mb-0">Trạng thái: <strong>@Model.Status</strong></p>
                                @if (Model.PlanExpiresAt.HasValue)
                                {
                                    <p class="mb-0">Hết hạn: <strong>@Model.PlanExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></p>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-4 border rounded-3 h-100 bg-light">
                                <h5>Gói Premium</h5>
                                <h2 class="text-warning">@premiumPrice.ToString("N0") đ</h2>
                                <ul class="mb-3">
                                    <li>Hiển thị nổi bật hơn</li>
                                    <li>Mở khóa tính năng nâng cao</li>
                                    <li>Dễ dàng quản lý sản phẩm</li>
                                </ul>
                                <form asp-action="CreatePayment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PlanCode" value="Premium" />
                                    <input type="hidden" name="Amount" value="@premiumPrice" />
                                    <button type="submit" class="btn btn-warning w-100">
                                        <i class="fas fa-credit-card me-1"></i>Tạo link thanh toán MoMo
                                    </button>
                                </form>
                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger mt-3 mb-0">@TempData["ErrorMessage"]</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
