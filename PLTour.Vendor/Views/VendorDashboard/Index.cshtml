@model PLTour.Shared.Models.Entities.Vendor
@{
    ViewData["Title"] = "Dashboard - Quản lý cửa hàng";
    Layout = "_VendorLayout";
    var stores = ViewBag.Stores as IEnumerable<PLTour.Shared.Models.Entities.VendorStore> ?? Enumerable.Empty<PLTour.Shared.Models.Entities.VendorStore>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Chào mừng, @Model.BusinessName!</h1>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-primary fs-6">
                    <i class="fas fa-crown me-1"></i>@(string.IsNullOrWhiteSpace(Model.Plan) ? "Free" : Model.Plan)
                </span>
                <span class="badge @(Model.Status == "Approved" ? "bg-success" : "bg-warning text-dark") fs-6">
                    <i class="fas @(Model.Status == "Approved" ? "fa-check-circle" : "fa-clock") me-1"></i>@Model.Status
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="VendorStore" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-store me-1"></i>Quản lý cửa hàng / POI
            </a>
            <a asp-controller="VendorProduct" asp-action="Index" class="btn btn-outline-info">
                <i class="fas fa-box me-1"></i>Sản phẩm theo cửa hàng
            </a>
            <a asp-controller="VendorSubscription" asp-action="Index" class="btn btn-warning">
                <i class="fas fa-arrow-up me-1"></i>Nâng cấp gói
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Cửa hàng</h6>
                            <h2 class="mb-0">@ViewBag.StoreCount</h2>
                        </div>
                        <i class="fas fa-store fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="VendorStore" asp-action="Index" class="text-white text-decoration-none">Quản lý cửa hàng <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Sản phẩm theo cửa hàng</h6>
                            <h2 class="mb-0">@ViewBag.ProductCount</h2>
                        </div>
                        <i class="fas fa-map-marker-alt fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="VendorProduct" asp-action="Index" class="text-white text-decoration-none">Quản lý sản phẩm <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Hình ảnh</h6>
                            <h2 class="mb-0">@ViewBag.ImageCount</h2>
                        </div>
                        <i class="fas fa-images fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/vendor/gallery" class="text-white text-decoration-none">Thư viện ảnh <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-store me-2"></i>Các cửa hàng của bạn</h5>
                    <a href="/vendor-store/create" class="btn btn-sm btn-primary">+ Thêm</a>
                </div>
                <div class="card-body">
                    @if (stores.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var store in stores)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@store.StoreName</div>
                                        <small class="text-muted d-block">@(store.IsDefault ? "Cửa hàng mặc định" : "Cửa hàng phụ")</small>
                                        <small class="text-muted d-block">POI: @(store.Location?.Name ?? "Chưa gắn")</small>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary" href="/vendor-store/edit/@store.StoreId">Sửa</a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Chưa có cửa hàng nào.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Thông tin tài khoản</h5>
                    <a asp-controller="VendorDashboard" asp-action="EditProfile" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit me-1"></i>Sửa
                    </a>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th style="width: 150px;">Tên tài khoản</th>
                            <td>@Model.BusinessName</td>
                        </tr>
                        <tr>
                            <th>Người liên hệ</th>
                            <td>@Model.ContactName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Số điện thoại</th>
                            <td>@Model.Phone</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
